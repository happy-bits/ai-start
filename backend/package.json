{
  "name": "keepwarm-crm",
  "version": "1.0.0",
  "description": "KeepWarm CRM REST API Backend",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "dev:seed": "SEED_DB=true npm run dev",
    "dev:seed:powershell": "$env:SEED_DB=\"true\"; npm run dev",
    "dev:seed:commandline": "SEED_DB=true && npm run dev",
    "build": "tsc",
    "start": "node dist/index.js",
    "test": "vitest",
    "test:run": "vitest run",
    "db:seed": "tsx src/db/seed.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate"
  },
  "dependencies": {
    "@hono/node-server": "^1.19.6",
    "@hono/zod-validator": "^0.7.5",
    "@node-rs/argon2": "^2.0.2",
    "better-sqlite3": "^12.5.0",
    "drizzle-orm": "^0.44.7",
    "hono": "^4.10.7",
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24.10.1",
    "drizzle-kit": "^0.31.7",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^4.0.14"
  }
}
