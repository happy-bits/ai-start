{
  "name": "keepwarm",
  "private": true,
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:seed": "node scripts/dev.mjs --seed",
    "prod": "DB_PATH=data/keepwarm-prod VITE_PROD_DB=true node scripts/dev.mjs",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "prepare": "husky",
    "test": "npm run test:backend && npm run test:frontend:unit && npm run test:frontend:e2e",
    "test:backend": "npm run test:run --prefix backend",
    "db:backup": "npm run db:backup --prefix backend",
    "test:frontend": "npm run test:frontend:unit && npm run test:frontend:e2e",
    "test:frontend:unit": "npm run test:run --prefix frontend",
    "test:frontend:e2e": "node scripts/run-e2e.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.0.3",
    "husky": "^9.1.7",
    "kill-port": "^2.0.1",
    "lint-staged": "^15.4.3"
  },
  "lint-staged": {
    "*.{js,ts,cjs,mjs,d.cts,d.mts,jsx,tsx,json,jsonc}": [
      "biome check --no-errors-on-unmatched --files-ignore-unknown=true"
    ]
  }
}
