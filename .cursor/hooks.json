{
  "version": 1,
  "hooks": {
    "preToolUse": [
      {
        "command": "bun run .cursor/hooks/warn-test-edits/index.ts",
        "matcher": "Write|StrReplace"
      }
    ],
    "beforeShellExecution": [
      {
        "command": "bun run .cursor/hooks/safe-shell/index.ts"
      }
      // Previous prompt-based solution:
      // {
      //   "type": "prompt",
      //   "prompt": "Does this command look safe to execute? Only allow read-only operations.",
      //   "timeout": 10
      // }
    ]
  }
}
