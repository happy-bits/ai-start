@{
    ViewData["Title"] = "Home Page";
}


@if (ViewBag.ShowDeveloperTools == true)
{
    <div class="row mt-5">
        <div class="col-md-8 offset-md-2">
            <div class="card border-warning">
                <div class="card-header bg-warning text-dark">
                    <h5 class="mb-0">🛠️ Utvecklarverktyg</h5>
                </div>
                <div class="card-body">
                    @if (TempData["DbMessage"] != null)
                    {
                        <div class="alert @(TempData["DbMessageType"]?.ToString() == "success" ? "alert-info" : "alert-warning") mb-3">
                            @TempData["DbMessage"]
                        </div>
                    }
                    <div class="row">
                        <div class="col-md-6">
                            <h6 class="text-muted mb-3">Databas</h6>
                            <form asp-controller="DeveloperTools" asp-action="RecreateDatabase" method="post" class="d-inline">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-outline-secondary btn-sm mb-3">
                                    <i class="bi bi-arrow-clockwise"></i> Återskapa databas med testdata
                                </button>
                            </form>
                        </div>
                        <div class="col-md-6">
                            <h6>Snabb inloggning</h6>
                            <div class="d-grid gap-2">
                                <button class="btn btn-outline-primary btn-sm login-btn" data-email="admin1@test.com">
                                    👤 Logga in som Admin1
                                </button>
                                <button class="btn btn-outline-primary btn-sm login-btn" data-email="admin2@test.com">
                                    👤 Logga in som Admin2
                                </button>
                                <button class="btn btn-outline-secondary btn-sm login-btn" data-email="user1@test.com">
                                    👤 Logga in som User1
                                </button>
                                <button class="btn btn-outline-secondary btn-sm login-btn" data-email="user2@test.com">
                                    👤 Logga in som User2
                                </button>
                                <button class="btn btn-outline-secondary btn-sm login-btn" data-email="user3@test.com">
                                    👤 Logga in som User3
                                </button>
                            </div>
                            <div id="loginResult" class="alert mt-2" style="display: none;"></div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <script>
        document.addEventListener('DOMContentLoaded', function() {
            // Snabb inloggning
            document.querySelectorAll('.login-btn').forEach(btn => {
                btn.addEventListener('click', function() {
                    const email = this.dataset.email;
                    const resultDiv = document.getElementById('loginResult');
                    
                    this.disabled = true;
                    const originalText = this.innerHTML;
                    this.innerHTML = '⏳ Loggar in...';
                    
                    fetch('/DeveloperTools/LoginAs', {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json',
                            'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]')?.value || ''
                        },
                        body: JSON.stringify(email)
                    })
                    .then(response => response.json())
                    .then(data => {
                        resultDiv.className = 'alert ' + (data.success ? 'alert-success' : 'alert-danger');
                        resultDiv.textContent = data.message;
                        resultDiv.style.display = 'block';
                        
                        if (data.success) {
                            setTimeout(() => {
                                window.location.reload();
                            }, 1000);
                        }
                    })
                    .catch(error => {
                        resultDiv.className = 'alert alert-danger';
                        resultDiv.textContent = 'Ett fel inträffade: ' + error.message;
                        resultDiv.style.display = 'block';
                    })
                    .finally(() => {
                        this.disabled = false;
                        this.innerHTML = originalText;
                    });
                });
            });
        });
    </script>
}