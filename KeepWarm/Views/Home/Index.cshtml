@{
    ViewData["Title"] = "Hem";
}


@if (ViewBag.ShowDeveloperTools == true)
{
    <div class="row mt-5">
        <div class="col-md-8 offset-md-2">
            <div class="modern-card">
                <div class="card-header">
                    <h5 class="mb-0"><i class="bi bi-tools"></i> Utvecklarverktyg</h5>
                </div>
                <div class="card-body">
                    <div class="row">
                        <div class="col-md-6">
                            <h6 class="text-muted mb-3">Databas</h6>
                            <button id="recreateDbBtn" class="btn btn-outline-secondary btn-sm mb-3">
                                <i class="bi bi-arrow-clockwise"></i> Återskapa databas med testdata
                            </button>
                            <div id="dbResult" class="alert" style="display: none;"></div>
                        </div>
                        <div class="col-md-6">
                            <h6 class="text-muted mb-3">Snabb inloggning</h6>
                            <div class="d-grid gap-2">
                                <button class="btn btn-outline-secondary btn-sm login-btn" data-email="admin1@test.com">
                                    <i class="bi bi-person"></i> Logga in som Admin1
                                </button>
                                <button class="btn btn-outline-secondary btn-sm login-btn" data-email="admin2@test.com">
                                    <i class="bi bi-person"></i> Logga in som Admin2
                                </button>
                                <button class="btn btn-outline-secondary btn-sm login-btn" data-email="user1@test.com">
                                    <i class="bi bi-person"></i> Logga in som User1
                                </button>
                                <button class="btn btn-outline-secondary btn-sm login-btn" data-email="user2@test.com">
                                    <i class="bi bi-person"></i> Logga in som User2
                                </button>
                                <button class="btn btn-outline-secondary btn-sm login-btn" data-email="user3@test.com">
                                    <i class="bi bi-person"></i> Logga in som User3
                                </button>
                            </div>
                            <div id="loginResult" class="alert mt-2" style="display: none;"></div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <script>
        document.addEventListener('DOMContentLoaded', function() {
            // Databasåterskapning
            document.getElementById('recreateDbBtn').addEventListener('click', function() {
                const btn = this;
                const resultDiv = document.getElementById('dbResult');
                
                btn.disabled = true;
                btn.innerHTML = '<i class="bi bi-hourglass-split"></i> Återskapar...';
                
                fetch('/DeveloperTools/RecreateDatabase', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]')?.value || ''
                    }
                })
                .then(response => response.json())
                .then(data => {
                    resultDiv.className = 'alert ' + (data.success ? 'alert-info' : 'alert-warning');
                    resultDiv.textContent = data.message;
                    resultDiv.style.display = 'block';
                })
                .catch(error => {
                    resultDiv.className = 'alert alert-warning';
                    resultDiv.textContent = 'Ett fel inträffade: ' + error.message;
                    resultDiv.style.display = 'block';
                })
                .finally(() => {
                    btn.disabled = false;
                    btn.innerHTML = '<i class="bi bi-arrow-clockwise"></i> Återskapa databas med testdata';
                });
            });

            // Snabb inloggning
            document.querySelectorAll('.login-btn').forEach(btn => {
                btn.addEventListener('click', function() {
                    const email = this.dataset.email;
                    const resultDiv = document.getElementById('loginResult');
                    
                    this.disabled = true;
                    const originalText = this.innerHTML;
                    this.innerHTML = '<i class="bi bi-hourglass-split"></i> Loggar in...';
                    
                    fetch('/DeveloperTools/LoginAs', {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json',
                            'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]')?.value || ''
                        },
                        body: JSON.stringify(email)
                    })
                    .then(response => response.json())
                    .then(data => {
                        resultDiv.className = 'alert ' + (data.success ? 'alert-info' : 'alert-warning');
                        resultDiv.textContent = data.message;
                        resultDiv.style.display = 'block';
                        
                        if (data.success) {
                            setTimeout(() => {
                                window.location.reload();
                            }, 1000);
                        }
                    })
                    .catch(error => {
                        resultDiv.className = 'alert alert-warning';
                        resultDiv.textContent = 'Ett fel inträffade: ' + error.message;
                        resultDiv.style.display = 'block';
                    })
                    .finally(() => {
                        this.disabled = false;
                        this.innerHTML = originalText;
                    });
                });
            });
        });
    </script>
}