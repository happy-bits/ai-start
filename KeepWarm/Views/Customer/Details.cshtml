@model KeepWarm.Models.Customer
@using KeepWarm.Models
@using System.ComponentModel.DataAnnotations
@using System.Reflection

@{
    ViewData["Title"] = "Kunddetaljer";
    var interactions = ViewBag.Interactions as IEnumerable<Interaction> ?? Enumerable.Empty<Interaction>();
    var createModel = ViewBag.CreateInteractionModel as KeepWarm.Controllers.ViewModels.InteractionCreateViewModel ?? new KeepWarm.Controllers.ViewModels.InteractionCreateViewModel { CustomerId = Model.Id, InteractionDate = DateTime.Now };
}

<div class="page-header">
    <h2 class="page-title">Kunddetaljer</h2>
    <div class="modern-btn-group">
        <a asp-action="Edit" asp-route-id="@Model.Id" class="action-btn action-edit" title="Redigera">
            <i class="bi bi-pencil"></i>
        </a>
        <a asp-action="Index" class="btn btn-secondary">
            <i class="bi bi-arrow-left"></i> Tillbaka
        </a>
    </div>
</div>

<div class="row">
    <div class="col-md-10">
        <div class="modern-card">
            <div class="card-body">
                <div class="row">
                    <div class="col-md-6">
                        <h5>Personlig information</h5>
                        <dl class="row">
                            <dt class="col-sm-4">Förnamn:</dt>
                            <dd class="col-sm-8">@Model.FirstName</dd>
                            
                            <dt class="col-sm-4">Efternamn:</dt>
                            <dd class="col-sm-8">@Model.LastName</dd>
                            
                            <dt class="col-sm-4">E-post:</dt>
                            <dd class="col-sm-8">
                                <a href="mailto:@Model.Email">@Model.Email</a>
                            </dd>
                            
                            <dt class="col-sm-4">Telefon:</dt>
                            <dd class="col-sm-8">
                                @if (!string.IsNullOrEmpty(Model.Phone))
                                {
                                    <a href="tel:@Model.Phone">@PhoneNumberFormatter.Format(Model.Phone)</a>
                                }
                                else
                                {
                                    <span class="text-muted">Inte angivet</span>
                                }
                            </dd>
                            
                            <dt class="col-sm-4">LinkedIn:</dt>
                            <dd class="col-sm-8">
                                @if (!string.IsNullOrEmpty(Model.LinkedInUrl))
                                {
                                    <a href="@Model.LinkedInUrl" target="_blank" rel="noopener noreferrer">
                                        <i class="bi bi-linkedin"></i> @Model.LinkedInUrl
                                    </a>
                                }
                                else
                                {
                                    <span class="text-muted">Inte angivet</span>
                                }
                            </dd>
                        </dl>
                    </div>
                    <div class="col-md-6">
                        <h5>Adressinformation</h5>
                        <dl class="row">
                            <dt class="col-sm-4">Adress:</dt>
                            <dd class="col-sm-8">
                                @if (!string.IsNullOrEmpty(Model.Address))
                                {
                                    @Model.Address
                                }
                                else
                                {
                                    <span class="text-muted">Inte angivet</span>
                                }
                            </dd>
                            
                            <dt class="col-sm-4">Stad:</dt>
                            <dd class="col-sm-8">
                                @if (!string.IsNullOrEmpty(Model.City))
                                {
                                    @Model.City
                                }
                                else
                                {
                                    <span class="text-muted">Inte angivet</span>
                                }
                            </dd>
                            
                            <dt class="col-sm-4">Postnummer:</dt>
                            <dd class="col-sm-8">
                                @if (!string.IsNullOrEmpty(Model.PostalCode))
                                {
                                    @Model.PostalCode
                                }
                                else
                                {
                                    <span class="text-muted">Inte angivet</span>
                                }
                            </dd>
                            
                            <dt class="col-sm-4">Land:</dt>
                            <dd class="col-sm-8">
                                @if (!string.IsNullOrEmpty(Model.Country))
                                {
                                    @Model.Country
                                }
                                else
                                {
                                    <span class="text-muted">Inte angivet</span>
                                }
                            </dd>
                        </dl>
                    </div>
                </div>
            </div>
        </div>

        <!-- Interaktioner -->
        <div class="modern-card mt-3">
            <div class="card-header d-flex justify-content-between align-items-center">
                <h5 class="mb-0">Interaktioner</h5>
                <button type="button" class="btn btn-sm btn-primary" data-bs-toggle="collapse" data-bs-target="#createInteractionForm" aria-expanded="false" aria-controls="createInteractionForm">
                    <i class="bi bi-plus-circle"></i> Logga ny interaktion
                </button>
            </div>
            <div class="card-body">
                <!-- Create Interaction Form (Collapsed by default) -->
                <div class="collapse mb-3 @(TempData["ShowInteractionForm"] != null ? "show" : "")" id="createInteractionForm">
                    <div class="card card-body bg-light">
                        <h6>Logga ny interaktion</h6>
                        <form asp-controller="Interaction" asp-action="Create" method="post">
                            <input type="hidden" name="CustomerId" value="@Model.Id" />
                            <div class="row">
                                <div class="col-md-4">
                                    <div class="mb-3">
                                        <label class="form-label">Typ</label>
                                        <select name="InteractionType" class="form-select" asp-items="Html.GetEnumSelectList<InteractionType>()"></select>
                                        <span class="text-danger"></span>
                                    </div>
                                </div>
                                <div class="col-md-4">
                                    <div class="mb-3">
                                        <label class="form-label">Datum och tid</label>
                                        <input name="InteractionDate" class="form-control" type="datetime-local" value="@DateTime.Now.ToString("yyyy-MM-ddTHH:mm")" />
                                        <span class="text-danger"></span>
                                    </div>
                                </div>
                                <div class="col-md-4">
                                    <div class="mb-3">
                                        <label class="form-label">Anteckningar</label>
                                        <textarea name="Notes" class="form-control" rows="1"></textarea>
                                        <span class="text-danger"></span>
                                    </div>
                                </div>
                            </div>
                            <div class="d-flex gap-2">
                                <button type="submit" class="btn btn-primary">
                                    <i class="bi bi-save"></i> Spara
                                </button>
                                <button type="button" class="btn btn-secondary" data-bs-toggle="collapse" data-bs-target="#createInteractionForm">
                                    Avbryt
                                </button>
                            </div>
                        </form>
                    </div>
                </div>

                <!-- Interactions List -->
                @if (interactions.Any())
                {
                    <div class="table-responsive" id="interactions-table">
                        <table class="table modern-table">
                            <thead>
                                <tr>
                                    <th>Typ</th>
                                    <th>Datum och tid</th>
                                    <th>Anteckningar</th>
                                    @if (User.IsInRole("Admin"))
                                    {
                                        <th>Loggad av</th>
                                    }
                                    <th>Åtgärder</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var interaction in interactions)
                                {
                                    <tr id="interaction-row-@interaction.Id">
                                        <td>
                                            <span class="interaction-type-display">
                                                @switch (interaction.InteractionType)
                                                {
                                                    case InteractionType.Call:
                                                        <span class="badge bg-info"><i class="bi bi-telephone"></i> Samtal</span>
                                                        break;
                                                    case InteractionType.Meeting:
                                                        <span class="badge bg-success"><i class="bi bi-calendar-event"></i> Möte</span>
                                                        break;
                                                    case InteractionType.Email:
                                                        <span class="badge bg-primary"><i class="bi bi-envelope"></i> E-post</span>
                                                        break;
                                                }
                                            </span>
                                            <div class="collapse" id="edit-type-@interaction.Id">
                                                <select class="form-select form-select-sm" name="InteractionType" form="edit-form-@interaction.Id">
                                                    @foreach (var type in Enum.GetValues<InteractionType>())
                                                    {
                                                        var field = typeof(InteractionType).GetField(type.ToString());
                                                        var displayAttribute = field?.GetCustomAttribute<DisplayAttribute>();
                                                        var displayName = displayAttribute?.GetName() ?? type.ToString();
                                                        <option value="@((int)type)" selected="@(type == interaction.InteractionType)">@displayName</option>
                                                    }
                                                </select>
                                            </div>
                                        </td>
                                        <td>
                                            <span class="interaction-date-display">@interaction.InteractionDate.ToString("yyyy-MM-dd HH:mm")</span>
                                            <div class="collapse" id="edit-date-@interaction.Id">
                                                <input type="datetime-local" class="form-control form-control-sm" name="InteractionDate" form="edit-form-@interaction.Id" value="@interaction.InteractionDate.ToString("yyyy-MM-ddTHH:mm")" />
                                            </div>
                                        </td>
                                        <td>
                                            <span class="interaction-notes-display">
                                                @if (!string.IsNullOrEmpty(interaction.Notes))
                                                {
                                                    <span>@interaction.Notes</span>
                                                }
                                                else
                                                {
                                                    <span class="text-muted">-</span>
                                                }
                                            </span>
                                            <div class="collapse" id="edit-notes-@interaction.Id">
                                                <textarea class="form-control form-control-sm" name="Notes" form="edit-form-@interaction.Id" rows="2">@interaction.Notes</textarea>
                                            </div>
                                        </td>
                                        @if (User.IsInRole("Admin"))
                                        {
                                            <td>
                                                @if (interaction.User != null)
                                                {
                                                    <small>@interaction.User.FirstName @interaction.User.LastName</small>
                                                }
                                            </td>
                                        }
                                        <td>
                                            <div class="modern-btn-group">
                                                <button type="button" class="action-btn action-edit" data-bs-toggle="collapse" data-bs-target="#edit-interaction-@interaction.Id" aria-expanded="false" aria-controls="edit-interaction-@interaction.Id" title="Redigera">
                                                    <i class="bi bi-pencil"></i>
                                                </button>
                                                <form asp-controller="Interaction" asp-action="Delete" method="post" class="d-inline">
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="id" value="@interaction.Id" />
                                                    <button type="submit" class="action-btn action-delete" title="Ta bort">
                                                        <i class="bi bi-trash"></i>
                                                    </button>
                                                </form>
                                            </div>
                                            <div class="collapse" id="edit-interaction-@interaction.Id" data-bs-parent="#interactions-table">
                                                <form asp-controller="Interaction" asp-action="Edit" method="post" id="edit-form-@interaction.Id" class="d-inline">
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="Id" value="@interaction.Id" />
                                                    <input type="hidden" name="CustomerId" value="@Model.Id" />
                                                    <div class="btn-group btn-group-sm">
                                                        <button type="submit" class="btn btn-success btn-sm">
                                                            <i class="bi bi-check"></i> Spara
                                                        </button>
                                                        <button type="button" class="btn btn-secondary btn-sm" data-bs-toggle="collapse" data-bs-target="#edit-interaction-@interaction.Id">
                                                            <i class="bi bi-x"></i> Avbryt
                                                        </button>
                                                    </div>
                                                </form>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <p class="text-muted">Inga interaktioner registrerade ännu.</p>
                }
            </div>
        </div>
    </div>
    
    <div class="col-md-4">
        <div class="card">
            <div class="card-header">
                <h5 class="mb-0">Systeminformation</h5>
            </div>
            <div class="card-body">
                <dl class="row">
                    <dt class="col-sm-5">Kund-ID:</dt>
                    <dd class="col-sm-7"><code>@Model.Id</code></dd>
                    
                    <dt class="col-sm-5">Skapad:</dt>
                    <dd class="col-sm-7">
                        <small>@Model.CreatedAt.ToString("yyyy-MM-dd HH:mm")</small>
                    </dd>
                    
                    <dt class="col-sm-5">Senast uppdaterad:</dt>
                    <dd class="col-sm-7">
                        <small>@Model.UpdatedAt.ToString("yyyy-MM-dd HH:mm")</small>
                    </dd>
                    
                    @if (User.IsInRole("Admin") && Model.User != null)
                    {
                        <dt class="col-sm-5">Skapad av:</dt>
                        <dd class="col-sm-7">
                            <span class="badge bg-info">@Model.User.FirstName @Model.User.LastName</span>
                            <br>
                            <small class="text-muted">@Model.User.Email</small>
                        </dd>
                    }
                </dl>
            </div>
        </div>
        
        <div class="card mt-3">
            <div class="card-header">
                <h5 class="mb-0">Åtgärder</h5>
            </div>
            <div class="card-body">
                <div class="d-grid gap-2">
                    <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning">
                        <i class="bi bi-pencil"></i> Redigera kund
                    </a>
                    <button type="button" class="btn btn-danger" data-bs-toggle="modal" data-bs-target="#deleteModal">
                        <i class="bi bi-trash"></i> Ta bort kund
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Delete Confirmation Modal -->
<div class="modal fade" id="deleteModal" tabindex="-1" aria-labelledby="deleteModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="deleteModalLabel">Bekräfta borttagning</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <p>Är du säker på att du vill ta bort kunden <strong>@Model.FirstName @Model.LastName</strong>?</p>
                <p class="text-danger"><strong>Denna åtgärd kan inte ångras.</strong></p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Avbryt</button>
                <form asp-action="Delete" method="post" class="d-inline">
                    <input type="hidden" asp-for="Id" />
                    <button type="submit" class="btn btn-danger">
                        <i class="bi bi-trash"></i> Ta bort
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <script>
        // Use Bootstrap collapse events to toggle display/edit visibility
        document.addEventListener('DOMContentLoaded', function() {
            const editButtons = document.querySelectorAll('[data-bs-target^="#edit-interaction-"]');
            editButtons.forEach(button => {
                const targetId = button.getAttribute('data-bs-target');
                const collapseElement = document.querySelector(targetId);
                
                if (collapseElement) {
                    collapseElement.addEventListener('show.bs.collapse', function() {
                        const id = this.id.replace('edit-interaction-', '');
                        toggleEditVisibility(id, true);
                    });
                    
                    collapseElement.addEventListener('hide.bs.collapse', function() {
                        const id = this.id.replace('edit-interaction-', '');
                        toggleEditVisibility(id, false);
                    });
                }
            });
        });
        
        function toggleEditVisibility(id, showEdit) {
            const row = document.getElementById('interaction-row-' + id);
            if (!row) return;
            
            const displays = row.querySelectorAll('.interaction-type-display, .interaction-date-display, .interaction-notes-display');
            const edits = row.querySelectorAll('#edit-type-' + id + ', #edit-date-' + id + ', #edit-notes-' + id);
            const actions = row.querySelector('.interaction-actions');
            
            displays.forEach(el => el.style.display = showEdit ? 'none' : '');
            edits.forEach(el => el.style.display = showEdit ? 'block' : 'none');
            if (actions) actions.style.display = showEdit ? 'none' : '';
        }
    </script>
}
