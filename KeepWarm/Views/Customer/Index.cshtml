@model IEnumerable<KeepWarm.Models.Customer>

@{
    ViewData["Title"] = "Kunder";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2>Kunder</h2>
    <a asp-action="Create" class="btn btn-primary">Skapa ny kund</a>
</div>

<div class="card shadow-sm border-0">
    <div class="card-body p-0">
        @if (Model.Any())
        {
            <div class="table-responsive">
                <table class="table table-hover mb-0 customer-table">
                    <thead>
                        <tr>
                            <th class="ps-4">Namn</th>
                            <th>E-post</th>
                            <th>Telefon</th>
                            <th>Adress</th>
                            <th>Stad</th>
                            <th>Skapad</th>
                            @if (User.IsInRole("Admin"))
                            {
                                <th>Skapad av</th>
                            }
                            <th class="text-end pe-4">Åtgärder</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var customer in Model)
                        {
                            <tr>
                                <td class="ps-4">
                                    <div class="d-flex align-items-center">
                                        <div class="customer-avatar me-2">
                                            <span>@((!string.IsNullOrEmpty(customer.FirstName) ? customer.FirstName.Substring(0, 1) : "") + (!string.IsNullOrEmpty(customer.LastName) ? customer.LastName.Substring(0, 1) : ""))</span>
                                        </div>
                                        <div>
                                            <strong class="customer-name">@customer.FirstName @customer.LastName</strong>
                                        </div>
                                    </div>
                                </td>
                                <td>
                                    <a href="mailto:@customer.Email" class="text-decoration-none">
                                        <i class="bi bi-envelope me-1"></i>@customer.Email
                                    </a>
                                </td>
                                <td>
                                    @if (!string.IsNullOrEmpty(customer.Phone))
                                    {
                                        <a href="tel:@customer.Phone" class="text-decoration-none">
                                            <i class="bi bi-telephone me-1"></i>@PhoneNumberFormatter.Format(customer.Phone)
                                        </a>
                                    }
                                    else
                                    {
                                        <span class="text-muted">-</span>
                                    }
                                </td>
                                <td>
                                    @if (!string.IsNullOrEmpty(customer.Address))
                                    {
                                        <span><i class="bi bi-geo-alt me-1 text-muted"></i>@customer.Address</span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">-</span>
                                    }
                                </td>
                                <td>
                                    @if (!string.IsNullOrEmpty(customer.City))
                                    {
                                        @customer.City
                                    }
                                    else
                                    {
                                        <span class="text-muted">-</span>
                                    }
                                </td>
                                <td>
                                    <span class="text-muted">@customer.CreatedAt.ToString("yyyy-MM-dd")</span>
                                </td>
                                @if (User.IsInRole("Admin"))
                                {
                                    <td>
                                        @if (customer.User != null)
                                        {
                                            <span class="badge bg-light text-dark border">@customer.User.FirstName @customer.User.LastName</span>
                                        }
                                        else
                                        {
                                            <span class="text-muted">-</span>
                                        }
                                    </td>
                                }
                                <td class="text-end pe-4">
                                    <div class="btn-group btn-group-sm" role="group">
                                        <a asp-action="Details" asp-route-id="@customer.Id" 
                                           class="btn btn-outline-primary btn-action" title="Visa detaljer">
                                            <i class="bi bi-eye"></i>
                                        </a>
                                        <a asp-action="Edit" asp-route-id="@customer.Id" 
                                           class="btn btn-outline-warning btn-action" title="Redigera">
                                            <i class="bi bi-pencil"></i>
                                        </a>
                                        <a asp-action="Delete" asp-route-id="@customer.Id" 
                                           class="btn btn-outline-danger btn-action" title="Ta bort">
                                            <i class="bi bi-trash"></i>
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="text-center py-5">
                <div class="mb-4">
                    <i class="bi bi-people display-1 text-muted"></i>
                </div>
                <h4 class="text-muted">Inga kunder hittades</h4>
                <p class="text-muted mb-4">Du har inte skapat några kunder än. Klicka på knappen nedan för att skapa din första kund.</p>
                <a asp-action="Create" class="btn btn-primary btn-lg">
                    <i class="bi bi-plus-circle"></i> Skapa första kunden
                </a>
            </div>
        }
    </div>
</div>

@section Scripts {
    <script>
        // Lägg till bekräftelse för borttagning
        document.addEventListener('DOMContentLoaded', function() {
            const deleteLinks = document.querySelectorAll('a[href*="Delete"]');
            deleteLinks.forEach(link => {
                link.addEventListener('click', function(e) {
                    // Ta bort preventDefault så att länken fungerar direkt
                });
            });
        });
    </script>
}
