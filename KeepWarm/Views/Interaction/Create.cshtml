@model KeepWarm.Controllers.ViewModels.InteractionCreateViewModel
@using KeepWarm.Helpers

@{
    ViewData["Title"] = "Skapa ny interaktion";
}

<div class="row">
    <div class="col-md-8">
        <div class="card">
            <div class="card-header d-flex justify-content-between align-items-center">
                <h4 class="mb-0">Skapa ny interaktion</h4>
                <a asp-controller="Customer" asp-action="Details" asp-route-id="@Model.CustomerId" class="btn btn-secondary">
                    <i class="bi bi-arrow-left"></i> Tillbaka
                </a>
            </div>
            <div class="card-body">
                <form asp-action="Create" method="post">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                    
                    <input asp-for="CustomerId" type="hidden" />
                    
                    <div class="form-group mb-3">
                        <label asp-for="InteractionType" class="form-label">Interaktionstyp *</label>
                        <select asp-for="InteractionType" class="form-select" required>
                            <option value="">Välj interaktionstyp</option>
                            @foreach (var type in Model.AvailableInteractionTypes)
                            {
                                <option value="@type">@type</option>
                            }
                        </select>
                        <span asp-validation-for="InteractionType" class="text-danger"></span>
                    </div>
                    
                    <div class="form-group mb-3">
                        <label asp-for="Description" class="form-label">Beskrivning *</label>
                        <textarea asp-for="Description" class="form-control" rows="4" maxlength="500" required></textarea>
                        <span asp-validation-for="Description" class="text-danger"></span>
                        <small class="form-text text-muted">Max 500 tecken</small>
                    </div>
                    
                    <div class="form-group mb-3">
                        <label asp-for="InteractionDate" class="form-label">Datum *</label>
                        <input asp-for="InteractionDate" type="datetime-local" class="form-control" required 
                               value="@DateTimeHelper.FormatForDateTimeLocalInput(Model.InteractionDate)" />
                        <span asp-validation-for="InteractionDate" class="text-danger"></span>
                    </div>
                    
                    <div class="form-group mb-3">
                        <label asp-for="FollowUpDate" class="form-label">Återkomstdatum</label>
                        <div class="input-group">
                            <input asp-for="FollowUpDate" type="date" class="form-control" />
                            <div class="input-group-text">
                                <input id="noFollowUpCheckbox" class="form-check-input mt-0" type="checkbox" />
                                <label for="noFollowUpCheckbox" class="ms-2 mb-0">Ingen återkomst</label>
                            </div>
                        </div>
                        <small class="form-text text-muted">Standard är 3 dagar framåt. Markera "Ingen återkomst" för att lämna tomt.</small>
                        <span asp-validation-for="FollowUpDate" class="text-danger"></span>
                    </div>
                    
                    <div class="form-group">
                        <button type="submit" class="btn btn-primary">
                            <i class="bi bi-plus-circle"></i> Skapa interaktion
                        </button>
                        <a asp-controller="Customer" asp-action="Details" asp-route-id="@Model.CustomerId" class="btn btn-secondary">
                            <i class="bi bi-x-circle"></i> Avbryt
                        </a>
                    </div>
                </form>
            </div>
        </div>
    </div>
    
    <div class="col-md-4">
        <div class="card">
            <div class="card-header">
                <h5 class="mb-0">Hjälp</h5>
            </div>
            <div class="card-body">
                <p class="text-muted">
                    <strong>Interaktionstyp:</strong> Välj den typ av kontakt du hade med kunden.
                </p>
                <p class="text-muted">
                    <strong>Beskrivning:</strong> Beskriv kortfattat vad som diskuterades eller hände under interaktionen.
                </p>
                <p class="text-muted">
                    <strong>Datum:</strong> Ange när interaktionen ägde rum.
                </p>
                <p class="text-muted">
                    <strong>Återkomstdatum:</strong> Välj dag då du ska återkomma (valfritt). Standard är idag + 3 dagar.
                </p>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <script>
        (function() {
            const checkbox = document.getElementById('noFollowUpCheckbox');
            const dateInput = document.getElementById('FollowUpDate');

            function updateState() {
                if (!checkbox || !dateInput) return;
                if (checkbox.checked) {
                    dateInput.value = '';
                    dateInput.setAttribute('disabled', 'disabled');
                } else {
                    dateInput.removeAttribute('disabled');
                }
            }

            if (checkbox && dateInput) {
                // Sätt initialt läge beroende på om modelvärdet är tomt
                if (!dateInput.value) {
                    checkbox.checked = true;
                }
                updateState();
                checkbox.addEventListener('change', updateState);
            }
        })();
    </script>
}
