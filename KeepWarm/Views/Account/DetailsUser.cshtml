@model KeepWarm.Models.ApplicationUser

@{
    ViewData["Title"] = "Användardetaljer";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2>Användardetaljer</h2>
    <a asp-action="ManageUsers" class="btn btn-secondary">Tillbaka</a>
</div>

<div class="card">
    <div class="card-body">
        <dl class="row">
            <dt class="col-sm-3">Namn</dt>
            <dd class="col-sm-9">@Model.FirstName @Model.LastName</dd>

            <dt class="col-sm-3">E-post</dt>
            <dd class="col-sm-9">@Model.Email</dd>

            <dt class="col-sm-3">Telefon</dt>
            <dd class="col-sm-9">@(Model.PhoneNumber ?? "-")</dd>

            <dt class="col-sm-3">Skapad</dt>
            <dd class="col-sm-9">@Model.CreatedAt.ToString("yyyy-MM-dd HH:mm")</dd>

            <dt class="col-sm-3">Uppdaterad</dt>
            <dd class="col-sm-9">@Model.UpdatedAt.ToString("yyyy-MM-dd HH:mm")</dd>
        </dl>
    </div>
</div>
