@model IEnumerable<KeepWarm.Models.ApplicationUser>

@{
    ViewData["Title"] = "Hantera användare";
}

<div class="page-header">
    <h2 class="page-title">Hantera användare</h2>
    <a asp-action="CreateUser" class="btn btn-primary btn-create">Skapa ny användare</a>
</div>

<div class="customer-table-container">
    @if (Model.Any())
    {
        <div class="table-responsive">
            <table class="table modern-table">
                    <thead>
                        <tr>
                            <th class="col-name">Namn</th>
                            <th class="col-email">E-post</th>
                            <th class="col-phone">Telefon</th>
                            <th class="col-created d-none d-lg-table-cell">Registrerad</th>
                            <th class="col-updated d-none d-lg-table-cell">Senast uppdaterad</th>
                            <th class="col-actions">Åtgärder</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var user in Model)
                        {
                            <tr>
                                <td class="col-name">
                                    <strong>@user.FirstName @user.LastName</strong>
                                </td>
                                <td class="col-email">
                                    <a href="mailto:@user.Email" class="customer-email">@user.Email</a>
                                </td>
                                <td class="col-phone">
                                    @if (!string.IsNullOrEmpty(user.PhoneNumber))
                                    {
                                        <a href="tel:@user.PhoneNumber" class="customer-phone">@user.PhoneNumber</a>
                                    }
                                    else
                                    {
                                        <span class="text-muted">-</span>
                                    }
                                </td>
                                <td class="col-created d-none d-lg-table-cell">
                                    <span class="customer-date">@user.CreatedAt.ToString("yyyy-MM-dd HH:mm")</span>
                                </td>
                                <td class="col-updated d-none d-lg-table-cell">
                                    <span class="customer-date">@user.UpdatedAt.ToString("yyyy-MM-dd HH:mm")</span>
                                </td>
                                <td class="col-actions">
                                    <div class="customer-actions">
                                        <button type="button" class="action-btn action-view" 
                                                onclick="viewUser('@user.Id')" title="Visa">
                                            <i class="bi bi-eye"></i>
                                        </button>
                                        <button type="button" class="action-btn action-edit" 
                                                onclick="editUser('@user.Id')" title="Redigera">
                                            <i class="bi bi-pencil"></i>
                                        </button>
                                        <button type="button" class="action-btn action-delete" 
                                                onclick="deleteUser('@user.Id')" title="Ta bort">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
    }
    else
    {
        <div class="customer-empty-state">
            <div class="empty-icon">
                <i class="bi bi-people"></i>
            </div>
            <h4 class="empty-title">Inga användare hittades</h4>
            <p class="empty-text">Du har inte skapat några användare än. Klicka på knappen nedan för att skapa din första användare.</p>
            <a asp-action="CreateUser" class="btn btn-primary">
                <i class="bi bi-plus-circle"></i> Skapa första användaren
            </a>
        </div>
    }
</div>

@section Scripts {
    <script>
        function viewUser(userId) {
            // Implementera visa användare
            // alert('Visa användare: ' + userId);
        }
        
        function editUser(userId) {
            window.location.href = '@Url.Action("EditUser", "Account")' + '?id=' + userId;
        }
        
        function deleteUser(userId) {
            // Skapa ett formulär för att skicka POST-förfrågan
            var form = document.createElement('form');
            form.method = 'POST';
            form.action = '@Url.Action("DeleteUser", "Account")';
                
                // Lägg till anti-forgery token
                var token = document.querySelector('input[name="__RequestVerificationToken"]');
                if (token) {
                    var tokenInput = document.createElement('input');
                    tokenInput.type = 'hidden';
                    tokenInput.name = '__RequestVerificationToken';
                    tokenInput.value = token.value;
                    form.appendChild(tokenInput);
                }
                
                // Lägg till användar-ID
                var idInput = document.createElement('input');
                idInput.type = 'hidden';
                idInput.name = 'id';
                idInput.value = userId;
                form.appendChild(idInput);
                
                // Skicka formuläret
                document.body.appendChild(form);
                form.submit();
        }
    </script>
}
